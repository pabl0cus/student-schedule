TRANSCRIPTION_DATA_DIR=./data
TRANSCRIPTION_MAX_UPLOAD_BYTES=524288000
TRANSCRIPTION_MAX_ATTACHMENT_BYTES=104857600
TRANSCRIPTION_MAX_JSON_BYTES=1048576
TRANSCRIPTION_MAX_WORKER_RESULT_BYTES=8388608
TRANSCRIPTION_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
TRANSCRIPTION_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TRANSCRIPTION_WORKER_POLL_SECONDS=1
TRANSCRIPTION_LOCAL_WORKER_ENABLED=false
TRANSCRIPTION_COMMUNITY_LEASE_SECONDS=600
TRANSCRIPTION_COMMUNITY_MAX_ATTEMPTS=5
TRANSCRIPTION_WORKER_TOKEN_PEPPER=
TRANSCRIPTION_AUDIO_PREPARATION_ENABLED=true
TRANSCRIPTION_AUDIO_PREPARATION_POLL_SECONDS=1
TRANSCRIPTION_AUDIO_PREPARATION_MAX_ATTEMPTS=3
TRANSCRIPTION_AUDIO_PREPARATION_TIMEOUT_SECONDS=21600
TRANSCRIPTION_MAX_PREPARED_AUDIO_BYTES=524288000
TRANSCRIPTION_FFMPEG_BINARY=ffmpeg
# Optional legacy local worker. Install requirements-local-worker.txt before enabling it.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Optional admin. Keep real values in an ignored .env file.
TRANSCRIPTION_ADMIN_USERNAME=
TRANSCRIPTION_ADMIN_PASSWORD_HASH=
TRANSCRIPTION_ADMIN_SESSION_SECRET=
TRANSCRIPTION_SECURE_COOKIES=false
